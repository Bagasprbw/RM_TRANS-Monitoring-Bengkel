# ============================================================
# Docker Environment Variables
# Salin file ini menjadi .env lalu sesuaikan valuenya
# ============================================================

# --- Database ---
DB_DATABASE=rm_trans
DB_USERNAME=rm_user
DB_PASSWORD=rm_password_ganti_ini
DB_ROOT_PASSWORD=root_secret_ganti_ini

# --- Laravel App ---
# Generate dengan: php artisan key:generate --show
# Atau: echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:GANTI_DENGAN_KEY_YANG_VALID_32_KARAKTER==
