[
  {
    "id": "deploy",
    "execute-command": "/deploy/deploy.sh",
    "command-working-directory": "/deploy",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ getenv \"WEBHOOK_SECRET\" }}",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    },
    "response-message": "Deploy triggered successfully!"
  }
]
